  <UserdefinedSymbols />
  <LuaScript>-- ============================================================================
-- Terraria 1.4.5.x x64 CoreCLR compatibility layer
-- Experimental port generated for Claire's gloader x64 Terraria runtime.
-- Uses Cheat Engine's .NET/.NET Core collectors to resolve live metadata/offsets.
-- ============================================================================

x64ct = x64ct or {}
x64ct.types = x64ct.types or {}
x64ct.typeIndex = x64ct.typeIndex or {}
x64ct.timers = x64ct.timers or {}
x64ct.buffState = x64ct.buffState or {}
x64ct.cleaners = x64ct.cleaners or {}
x64ct.drop = x64ct.drop or { enabled100=false, enabledMult=false }
x64ct.rerolls = x64ct.rerolls or {}

local function x64ctHex(v)
  if not v then return '0' end
  return string.format('%X',v)
end

local function x64ctSafeDestroy(o)
  if o then pcall(function() o.destroy() end) end
end

function x64ctUnsupported(name, reason)
  error(name..' is not enabled in this first x64 port. '..reason)
end

function x64ctStopTimer(key)
  local t=x64ct.timers[key]
  if t then
    t.Enabled=false
    x64ctSafeDestroy(t)
    x64ct.timers[key]=nil
  end
end

function x64ctStartTimer(key, interval, fn)
  x64ctStopTimer(key)
  local t=createTimer(nil)
  t.Interval=interval
  t.OnTimer=function()
    local ok,err=pcall(fn)
    if not ok then
      t.Enabled=false
      print('[Terraria x64 CT] '..key..' stopped: '..tostring(err))
    end
  end
  x64ct.timers[key]=t
  local ok,err=pcall(fn)
  if not ok then
    x64ctStopTimer(key)
    error(err)
  end
  t.Enabled=true
  return t
end

function x64ctEnsureDotNet()
  if getOpenedProcessID()==0 then error('No process is attached. Launch Terraria through gloader first.') end
  if not targetIs64Bit() then
    error('This is the x64 port. Attach Cheat Engine to the running 64-bit gloader.exe Terraria process, not stock Terraria.exe.')
  end
  if type(LaunchDotNetInterface)~='function' or type(getDotNetDataCollector)~='function' then
    error('Cheat Engine .NET/.NET Core support is unavailable. CE 7.5+ with its normal autorun files is required.')
  end
  local ok,ret=pcall(LaunchDotNetInterface)
  if not ok or ret==false then error('Cheat Engine could not start its .NET Core interface: '..tostring(ret)) end
  x64ct.dc=getDotNetDataCollector()
  if not x64ct.dc then error('Cheat Engine could not obtain the .NET data collector.') end
  if not x64ct.nullHandle or x64ct.nullHandle==0 then
    x64ct.nullHandle=dotnet_wrapobject(0)
  end
  return true
end

function x64ctIndexTypes()
  if x64ct.indexed then return end
  x64ctEnsureDotNet()
  local dc=x64ct.dc
  local domains=dc.enumDomains() or {}
  local fallback={}
  for i=1,#domains do
    local modules=dc.enumModuleList(domains[i].DomainHandle) or {}
    for j=1,#modules do
      local mn=extractFileName(modules[j].Name or '')
      local low=string.lower(mn)
      if string.find(low,'terraria',1,true) then
        local mid=dotnet_getModuleID(mn)
        local classes=dc.enumTypeDefs(modules[j].ModuleHandle) or {}
        for k=1,#classes do
          local n=classes[k].Name
          if n and string.sub(n,1,9)=='Terraria.' then
            local cur=x64ct.typeIndex[n]
            local preferred=(low=='terrariarelease.dll')
            if (not cur) or preferred then
              x64ct.typeIndex[n]={
                name=n,
                token=classes[k].TypeDefToken,
                moduleHandle=modules[j].ModuleHandle,
                moduleName=mn,
                moduleId=mid,
                preferred=preferred
              }
            end
          end
        end
      else
        fallback[#fallback+1]={domain=domains[i],module=modules[j]}
      end
    end
  end
  -- Fallback for a differently named assembly: only pay the cost if Terraria.Main wasn't found.
  if not x64ct.typeIndex['Terraria.Main'] then
    for _,pair in ipairs(fallback) do
      local m=pair.module
      local classes=dc.enumTypeDefs(m.ModuleHandle) or {}
      local mn=extractFileName(m.Name or '')
      local mid=dotnet_getModuleID(mn)
      for k=1,#classes do
        local n=classes[k].Name
        if n and string.sub(n,1,9)=='Terraria.' then
          x64ct.typeIndex[n]={name=n,token=classes[k].TypeDefToken,moduleHandle=m.ModuleHandle,moduleName=mn,moduleId=mid}
        end
      end
      if x64ct.typeIndex['Terraria.Main'] then break end
    end
  end
  if not x64ct.typeIndex['Terraria.Main'] then
    error('Terraria.Main was not found in the attached CoreCLR process. Make sure the actual game is running through gloader.')
  end
  if x64ct.typeIndex['Terraria.Main'].moduleId==nil then
    error('Cheat Engine found Terraria metadata but its invasive CoreCLR module map did not resolve the game assembly.')
  end
  x64ct.indexed=true
end

function x64ctType(name, optional)
  x64ctIndexTypes()
  if x64ct.types[name] then return x64ct.types[name] end
  local m=x64ct.typeIndex[name]
  if not m then
    if optional then return nil end
    error('Managed type not found: '..name)
  end
  local td=x64ct.dc.getTypeDefData(m.moduleHandle,m.token)
  if not td then
    if optional then return nil end
    error('Could not read managed type layout: '..name)
  end
  local fields={}
  if td.Fields then
    for i=1,#td.Fields do
      local f=td.Fields[i]
      fields[f.Name]=f
    end
  end
  m.data=td
  m.fields=fields
  m.methods=x64ct.dc.getTypeDefMethods(m.moduleHandle,m.token) or {}
  x64ct.types[name]=m
  return m
end

function x64ctField(typeName, fieldName, optional)
  local t=x64ctType(typeName,optional)
  if not t then return nil end
  local f=t.fields[fieldName]
  if not f and typeName=='Terraria.Player' then
    local et=x64ctType('Terraria.Entity',true)
    if et then f=et.fields[fieldName] end
  end
  if not f and optional then return nil end
  if not f then error(typeName..'.'..fieldName..' field was not found in this Terraria build.') end
  return f
end

function x64ctMethod(typeName, methodName, paramCount, optional)
  local t=x64ctType(typeName,optional)
  if not t then return nil end
  local matches={}
  for i=1,#t.methods do
    local m=t.methods[i]
    if m.Name==methodName then
      local accept=true
      if paramCount~=nil then
        local ok,ret,sig,types=pcall(dotnet_getMethodParameters,t.moduleId,m.MethodToken)
        if not ok or not types or (#types-1)~=paramCount then accept=false end
      end
      if accept then matches[#matches+1]=m end
    end
  end
  if #matches==0 then
    if optional then return nil end
    error(typeName..'.'..methodName..' method was not found.')
  end
  if #matches&gt;1 and paramCount~=nil then
    if optional then return nil end
    error(typeName..'.'..methodName..' overload was ambiguous.')
  end
  return matches[1],t
end

function x64ctMethodEntry(typeName, methodName, paramCount)
  local m,t=x64ctMethod(typeName,methodName,paramCount,false)
  local a=dotnet_getMethodEntryPoint(t.moduleId,m.MethodToken)
  if not a or a==0 then error('Could not JIT/resolve '..typeName..'.'..methodName) end
  return a,m,t
end

function x64ctParseObjectValue(s)
  if not s or s=='' or s=='null' then return 0 end
  local h=string.match(s,':%s*([0-9A-Fa-f]+)%s*$')
  if not h then return 0 end
  local n=tonumber('0x'..h)
  return n or 0
end

function x64ctStaticObject(typeName, fieldName)
  local t=x64ctType(typeName,false)
  local f=x64ctField(typeName,fieldName,true)
  if f and f.IsStatic then
    local s=dotnet_getFieldValue(t.moduleId,f.Token,0)
    local p=x64ctParseObjectValue(s)
    if p~=0 then return p end
  end
  local m=x64ctMethod(typeName,'get_'..fieldName,0,true)
  if m then
    local h=dotnet_invoke_method(t.moduleId,m.MethodToken,x64ct.nullHandle,{})
    if h and h~=0 then
      local p=readPointer(h) or 0
      pcall(dotnet_unwrapobject,h)
      return p
    end
  end
  return 0
end

function x64ctGetRecord(id)
  local al=getAddressList()
  for i=0,al.Count-1 do
    local mr=al.getMemoryRecord(i)
    local ok,v=pcall(function() return tonumber(mr.ID) end)
    if ok and v==id then return mr end
  end
  return nil
end

function x64ctSetDirectRecord(id, off)
  local mr=x64ctGetRecord(id)
  if not mr then return end
  mr.Address='[myPlayer]+'..x64ctHex(off)
  mr.OffsetCount=0
end

function x64ctSetPointerRecord(id, baseOff, finalOff)
  local mr=x64ctGetRecord(id)
  if not mr then return end
  mr.Address='[myPlayer]+'..x64ctHex(baseOff)
  mr.OffsetCount=1
  mr.Offset[0]=finalOff
end

function x64ctSetArrayItemRecord(id, arrOff, firstOff, fieldOff)
  local mr=x64ctGetRecord(id)
  if not mr then return end
  mr.Address='[myPlayer]+'..x64ctHex(arrOff)
  mr.OffsetCount=2
  mr.Offset[0]=fieldOff
  mr.Offset[1]=firstOff
end

function x64ctPatchRecords()
  local pfields={
    [3]='statLife',[4]='statLifeMax',[5]='statMana',[6]='statManaMax',
    [7]='statDefense',[8]='luck',[9]='breath',[10]='breathMax',[11]='respawnTimer',
    [154]='lavaTime',[155]='lavaMax',[156]='wingTime',[157]='wingTimeMax'
  }
  for id,name in pairs(pfields) do
    local f=x64ctField('Terraria.Player',name,true)
    if f then x64ctSetDirectRecord(id,f.Offset) end
  end

  local nf=x64ctField('Terraria.Player','name',true)
  if nf then
    -- x64 CoreCLR System.String: length @ +8, first UTF-16 char @ +0xC.
    x64ctSetPointerRecord(158,nf.Offset,0x0C)
    x64ctSetPointerRecord(159,nf.Offset,0x08)
  end

  local inv=x64ctField('Terraria.Player','inventory',true)
  if inv then
    local imap={
      [16]='type',[17]='prefix',[18]='stack',[19]='maxStack',[20]='favorited',[21]='rare',
      [22]='damage',[23]='crit',[24]='knockBack',[25]='useTime',[26]='useAnimation',
      [27]='autoReuse',[28]='scale',[29]='mana',[30]='defense',[31]='value',[32]='healLife',
      [33]='healMana',[34]='shoot',[35]='shootSpeed',[36]='useAmmo',[37]='ammo',
      [38]='createTile',[39]='createWall',[40]='pick',[41]='axe',[42]='hammer',
      [43]='tileBoost',[44]='fishingPole',[45]='buffType',[46]='buffTime',[47]='mountType'
    }
    for id,name in pairs(imap) do
      local f=x64ctField('Terraria.Item',name,true)
      if f then x64ctSetArrayItemRecord(id,inv.Offset,0x10,f.Offset) end
    end
  end
end

function x64ctRefreshPlayerHandle()
  local m,t=x64ctMethod('Terraria.Main','get_LocalPlayer',0,false)
  local h=dotnet_invoke_method(t.moduleId,m.MethodToken,x64ct.nullHandle,{})
  local p=0
  if h and h~=0 then p=readPointer(h) or 0 end
  if x64ct.playerHandle and x64ct.playerHandle~=0 then pcall(dotnet_unwrapobject,x64ct.playerHandle) end
  x64ct.playerHandle=h
  if x64ct.myPlayerStorage then writePointer(x64ct.myPlayerStorage,p) end
  return p
end

function x64ctPlayer()
  if not x64ct.myPlayerStorage then return 0 end
  local p=readPointer(x64ct.myPlayerStorage)
  if not p then return 0 end
  return p
end

function x64ctEnable()
  x64ctEnsureDotNet()
  if x64ct.myPlayerStorage then return end
  pcall(unregisterSymbol,'myPlayer')
  x64ct.myPlayerStorage=allocateMemory(8)
  if not x64ct.myPlayerStorage then error('Could not allocate the x64 myPlayer pointer cell.') end
  writePointer(x64ct.myPlayerStorage,0)
  registerSymbol('myPlayer',x64ct.myPlayerStorage,true)
  x64ctIndexTypes()
  x64ctRefreshPlayerHandle()
  x64ctPatchRecords()
  x64ct.playerRefreshTick=0
  x64ctStartTimer('player-refresh',250,function()
    x64ct.playerRefreshTick=x64ct.playerRefreshTick+1
    local p=(x64ct.playerHandle and readPointer(x64ct.playerHandle)) or 0
    if x64ct.myPlayerStorage then writePointer(x64ct.myPlayerStorage,p or 0) end
    if x64ct.playerRefreshTick%8==0 then x64ctRefreshPlayerHandle() end
  end)
  print('[Terraria x64 CT] CoreCLR metadata resolver enabled; myPlayer='..x64ctHex(x64ctPlayer()))
end

function x64ctStopFeatures()
  -- Run feature-specific cleanup first so original values/bytes and GC handles are restored.
  pcall(x64ctDisableFly)
  pcall(x64ctDisableGod)
  pcall(x64ctDisableAllBanners)
  pcall(x64ctDisableInfiniteMana)
  pcall(x64ctDisableInfiniteAmmo)
  pcall(x64ctDisableNpcImmortal)
  pcall(x64ctDisableMaxStackHotkey)
  pcall(x64ctDisableItemVacuum,true)
  pcall(x64ctDisableDrop100,true)
  pcall(x64ctDisableDropMultiplier,true)
  pcall(x64ctDisableRerolls,true)

  local buffs={}
  for _,st in pairs(x64ct.buffState) do
    if st and st.buffId and st.recordKey then buffs[#buffs+1]={st.buffId,st.recordKey} end
  end
  for _,b in ipairs(buffs) do pcall(x64ctDisableBuff,b[1],b[2]) end

  local keys={}
  for k,_ in pairs(x64ct.timers) do if k~='player-refresh' then keys[#keys+1]=k end end
  for _,k in ipairs(keys) do x64ctStopTimer(k) end
end

function x64ctDisable()
  x64ctStopFeatures()
  x64ctStopTimer('player-refresh')
  if x64ct.playerHandle and x64ct.playerHandle~=0 then pcall(dotnet_unwrapobject,x64ct.playerHandle) end
  x64ct.playerHandle=nil
  if x64ct.nullHandle and x64ct.nullHandle~=0 then pcall(dotnet_unwrapobject,x64ct.nullHandle) end
  x64ct.nullHandle=nil
  pcall(unregisterSymbol,'myPlayer')
  if x64ct.myPlayerStorage then pcall(deAlloc,x64ct.myPlayerStorage) end
  x64ct.myPlayerStorage=nil
  x64ct.indexed=nil
  x64ct.typeIndex={}
  x64ct.types={}
end

-- --------------------------------------------------------------------------
-- Buffs and debuff cleaners
-- --------------------------------------------------------------------------
function x64ctBuffArrays()
  local p=x64ctPlayer(); if p==0 then return nil end
  local ft=x64ctField('Terraria.Player','buffType',false)
  local fm=x64ctField('Terraria.Player','buffTime',false)
  local at=readPointer(p+ft.Offset) or 0
  local am=readPointer(p+fm.Offset) or 0
  if at==0 or am==0 then return nil end
  local nt=readInteger(at+8) or 0
  local nm=readInteger(am+8) or 0
  local n=math.min(nt,nm)
  return at,am,n
end

function x64ctFindBuff(buffId, allowFree)
  local at,am,n=x64ctBuffArrays()
  if not at then return nil end
  local free=nil
  for i=0,n-1 do
    local v=readInteger(at+0x10+i*4) or 0
    if v==buffId then return i,at,am,n,false end
    if allowFree and free==nil and v==0 then free=i end
  end
  if free~=nil then return free,at,am,n,true end
  return nil,at,am,n,false
end

function x64ctEnableBuff(buffId,key)
  key='buff:'..tostring(key)
  if x64ct.buffState[key] then return end
  local slot,at,am,n,isFree=x64ctFindBuff(buffId,true)
  local st={inserted=false,originalTime=nil,buffId=buffId,recordKey=string.gsub(tostring(key),'^buff:','')}
  if slot~=nil then
    if isFree then st.inserted=true else st.originalTime=readInteger(am+0x10+slot*4) or 0 end
  end
  x64ct.buffState[key]=st
  x64ctStartTimer(key,100,function()
    local s,tarr,marr,n2,free=x64ctFindBuff(buffId,true)
    if s==nil then return end
    if free then
      writeInteger(tarr+0x10+s*4,buffId)
      writeInteger(marr+0x10+s*4,600)
      st.inserted=true
    else
      local tm=readInteger(marr+0x10+s*4) or 0
      if tm&lt;600 then writeInteger(marr+0x10+s*4,600) end
    end
  end)
end

function x64ctDisableBuff(buffId,key)
  key='buff:'..tostring(key)
  x64ctStopTimer(key)
  local st=x64ct.buffState[key]
  if st then
    local slot,at,am=x64ctFindBuff(buffId,false)
    if slot~=nil then
      if st.inserted and st.originalTime==nil then
        writeInteger(at+0x10+slot*4,0)
        writeInteger(am+0x10+slot*4,0)
      elseif st.originalTime~=nil then
        writeInteger(am+0x10+slot*4,math.max(st.originalTime,1))
      end
    end
  end
  x64ct.buffState[key]=nil
end

function x64ctClearBuff(buffId)
  local slot,at,am=x64ctFindBuff(buffId,false)
  if slot~=nil then
    writeInteger(at+0x10+slot*4,0)
    writeInteger(am+0x10+slot*4,0)
  end
end

function x64ctWritePlayerIntIfPresent(name,value)
  local p=x64ctPlayer(); if p==0 then return end
  local f=x64ctField('Terraria.Player',name,true)
  if f then writeInteger(p+f.Offset,value) end
end

function x64ctWritePlayerBoolIfPresent(name,value)
  local p=x64ctPlayer(); if p==0 then return end
  local f=x64ctField('Terraria.Player',name,true)
  if f then writeByte(p+f.Offset,value and 1 or 0) end
end

function x64ctEnableCleaner(key,buffId,mode)
  x64ctStartTimer('clean:'..key,50,function()
    x64ctClearBuff(buffId)
    if mode=='potion' then
      for _,n in ipairs({'potionDelay','restorationDelayTime','mushroomDelayTime','potionDelayTime'}) do
        x64ctWritePlayerIntIfPresent(n,0)
      end
    elseif mode=='chaos' then
      x64ctWritePlayerBoolIfPresent('chaosState',false)
    end
  end)
end

function x64ctDisableCleaner(key)
  x64ctStopTimer('clean:'..key)
end

-- --------------------------------------------------------------------------
-- Max Stack Hovered Item
-- --------------------------------------------------------------------------
function x64ctMaxStackHovered()
  local p=x64ctPlayer(); if p==0 then return end
  local hov=x64ctStaticObject('Terraria.Main','HoverItem')
  if not hov or hov==0 then return end
  local ftype=x64ctField('Terraria.Item','type',false)
  local fpref=x64ctField('Terraria.Item','prefix',false)
  local fstack=x64ctField('Terraria.Item','stack',false)
  local fmax=x64ctField('Terraria.Item','maxStack',false)
  local htype=readInteger(hov+ftype.Offset) or 0
  if htype==0 then return end
  local hpref=readByte(hov+fpref.Offset) or 0
  local hstack=readInteger(hov+fstack.Offset) or 0

  local arrays={}
  local invf=x64ctField('Terraria.Player','inventory',true)
  if invf then
    local a=readPointer(p+invf.Offset) or 0
    if a~=0 then arrays[#arrays+1]=a end
  end
  local chest=x64ctType('Terraria.Chest',true)
  local chitem=chest and x64ctField('Terraria.Chest','item',true) or nil
  if chitem then
    for _,name in ipairs({'bank','bank2','bank3','bank4'}) do
      local bf=x64ctField('Terraria.Player',name,true)
      if bf then
        local ch=readPointer(p+bf.Offset) or 0
        if ch~=0 then
          local a=readPointer(ch+chitem.Offset) or 0
          if a~=0 then arrays[#arrays+1]=a end
        end
      end
    end
  end

  for _,arr in ipairs(arrays) do
    local n=readInteger(arr+8) or 0
    for i=0,n-1 do
      local it=readPointer(arr+0x10+i*8) or 0
      if it~=0 and (readInteger(it+ftype.Offset) or 0)==htype and
         (readByte(it+fpref.Offset) or 0)==hpref and (readInteger(it+fstack.Offset) or 0)==hstack then
        local mx=readInteger(it+fmax.Offset) or 0
        if mx&gt;0 then writeInteger(it+fstack.Offset,mx) end
        return
      end
    end
  end
end

function x64ctEnableMaxStackHotkey()
  x64ctDisableMaxStackHotkey()
  x64ct.maxStackHotkey=createHotkey(function()
    local ok,err=pcall(x64ctMaxStackHovered)
    if not ok then print('[Terraria x64 CT] Max Stack: '..tostring(err)) end
  end,VK_CONTROL,VK_F2)
end

function x64ctDisableMaxStackHotkey()
  if x64ct.maxStackHotkey then x64ctSafeDestroy(x64ct.maxStackHotkey) x64ct.maxStackHotkey=nil end
end

-- --------------------------------------------------------------------------
-- All Banners
-- --------------------------------------------------------------------------
function x64ctEnableAllBanners()
  local t=x64ctType('Terraria.SceneMetrics',false)
  local objs=x64ct.dc.enumAllObjectsOfType(t.moduleHandle,t.token) or {}
  if #objs==0 then error('No live SceneMetrics object was found.') end
  if x64ct.bannerHandle then pcall(dotnet_unwrapobject,x64ct.bannerHandle) end
  x64ct.bannerHandle=dotnet_wrapobject(objs[1])
  if not x64ct.bannerHandle or x64ct.bannerHandle==0 then error('Could not hold the SceneMetrics object.') end
  local fb=x64ctField('Terraria.SceneMetrics','NPCBannerBuff',false)
  local fh=x64ctField('Terraria.SceneMetrics','hasBanner',false)
  x64ctStartTimer('all-banners',10,function()
    local sm=readPointer(x64ct.bannerHandle) or 0
    if sm==0 then return end
    local arr=readPointer(sm+fb.Offset) or 0
    if arr~=0 then
      local n=readInteger(arr+8) or 0
      for i=0,n-1 do writeByte(arr+0x10+i,1) end
    end
    writeByte(sm+fh.Offset,1)
  end)
end
function x64ctDisableAllBanners()
  x64ctStopTimer('all-banners')
  if x64ct.bannerHandle then pcall(dotnet_unwrapobject,x64ct.bannerHandle) end
  x64ct.bannerHandle=nil
end

-- --------------------------------------------------------------------------
-- God mode
-- --------------------------------------------------------------------------
function x64ctEnableGod()
  local p=x64ctPlayer(); if p==0 then error('Enter a world before enabling God Mode.') end
  local f=x64ctField('Terraria.Player','creativeGodMode',false)
  x64ct.godOriginal=(readByte(p+f.Offset) or 0)~=0
  x64ctStartTimer('god',10,function()
    local q=x64ctPlayer(); if q~=0 then writeByte(q+f.Offset,1) end
  end)
end
function x64ctDisableGod()
  x64ctStopTimer('god')
  local p=x64ctPlayer()
  local f=x64ctField('Terraria.Player','creativeGodMode',true)
  if p~=0 and f and x64ct.godOriginal~=nil then writeByte(p+f.Offset,x64ct.godOriginal and 1 or 0) end
  x64ct.godOriginal=nil
end

-- --------------------------------------------------------------------------
-- Fly + Noclip: direct Entity.position/velocity + Player control/ghost fields
-- --------------------------------------------------------------------------
function x64ctEnableFly()
  local p=x64ctPlayer(); if p==0 then error('Enter a world before enabling Fly + Noclip.') end
  local pos=x64ctField('Terraria.Player','position',false)
  local vel=x64ctField('Terraria.Player','velocity',false)
  local ghost=x64ctField('Terraria.Player','ghost',false)
  local fl=x64ctField('Terraria.Player','controlLeft',false)
  local fr=x64ctField('Terraria.Player','controlRight',false)
  local fu=x64ctField('Terraria.Player','controlUp',false)
  local fd=x64ctField('Terraria.Player','controlDown',false)
  local fj=x64ctField('Terraria.Player','controlJump',false)
  x64ct.flyGhostOriginal=(readByte(p+ghost.Offset) or 0)~=0
  x64ct.flyEnabledGod=false
  local g=x64ctGetRecord(140)
  if g and not g.Active then
    local ok=pcall(function() g.Active=true end)
    if ok then x64ct.flyEnabledGod=true end
  end
  x64ctStartTimer('fly',15,function()
    local q=x64ctPlayer(); if q==0 then return end
    writeByte(q+ghost.Offset,1)
    local dx,dy=0,0
    if (readByte(q+fl.Offset) or 0)~=0 then dx=dx-1 end
    if (readByte(q+fr.Offset) or 0)~=0 then dx=dx+1 end
    if (readByte(q+fu.Offset) or 0)~=0 then dy=dy-1 end
    if (readByte(q+fd.Offset) or 0)~=0 then dy=dy+1 end
    if (readByte(q+fj.Offset) or 0)~=0 then dy=dy-1 end
    local speed=8.0
    if dx~=0 and dy~=0 then speed=speed*0.70710678 end
    local x=readFloat(q+pos.Offset) or 0
    local y=readFloat(q+pos.Offset+4) or 0
    writeFloat(q+pos.Offset,x+dx*speed)
    writeFloat(q+pos.Offset+4,y+dy*speed)
    writeFloat(q+vel.Offset,0)
    writeFloat(q+vel.Offset+4,0)
  end)
end

function x64ctDisableFly()
  x64ctStopTimer('fly')
  local p=x64ctPlayer()
  local ghost=x64ctField('Terraria.Player','ghost',true)
  local vel=x64ctField('Terraria.Player','velocity',true)
  if p~=0 and ghost and x64ct.flyGhostOriginal~=nil then writeByte(p+ghost.Offset,x64ct.flyGhostOriginal and 1 or 0) end
  if p~=0 and vel then writeFloat(p+vel.Offset,0) writeFloat(p+vel.Offset+4,0) end
  if x64ct.flyEnabledGod then
    local g=x64ctGetRecord(140)
    if g then pcall(function() g.Active=false end) end
  end
  x64ct.flyEnabledGod=false
  x64ct.flyGhostOriginal=nil
end

-- --------------------------------------------------------------------------
-- Infinite mana (non-decreasing current mana, capped by current max)
-- --------------------------------------------------------------------------
function x64ctEnableInfiniteMana()
  local p=x64ctPlayer(); if p==0 then error('Enter a world before enabling Infinite Mana.') end
  local fm=x64ctField('Terraria.Player','statMana',false)
  local fmax=x64ctField('Terraria.Player','statManaMax2',true) or x64ctField('Terraria.Player','statManaMax',false)
  x64ct.manaBaseline=readInteger(p+fm.Offset) or 0
  x64ctStartTimer('infinite-mana',10,function()
    local q=x64ctPlayer(); if q==0 then return end
    local cur=readInteger(q+fm.Offset) or 0
    local mx=readInteger(q+fmax.Offset) or cur
    if x64ct.manaBaseline&gt;mx then x64ct.manaBaseline=mx end
    if cur&lt;x64ct.manaBaseline then
      writeInteger(q+fm.Offset,x64ct.manaBaseline)
    elseif cur&gt;x64ct.manaBaseline then
      x64ct.manaBaseline=math.min(cur,mx)
    end
  end)
end
function x64ctDisableInfiniteMana() x64ctStopTimer('infinite-mana') x64ct.manaBaseline=nil end

-- --------------------------------------------------------------------------
-- Infinite ammo: x64-safe stack refill. It is intentionally labeled best effort.
-- --------------------------------------------------------------------------
function x64ctEnableInfiniteAmmo()
  local p=x64ctPlayer(); if p==0 then error('Enter a world before enabling Infinite Ammo.') end
  local invf=x64ctField('Terraria.Player','inventory',false)
  local ft=x64ctField('Terraria.Item','type',false)
  local fp=x64ctField('Terraria.Item','prefix',false)
  local fs=x64ctField('Terraria.Item','stack',false)
  local fa=x64ctField('Terraria.Item','ammo',false)
  x64ct.ammoState={}
  x64ctStartTimer('infinite-ammo',10,function()
    local q=x64ctPlayer(); if q==0 then return end
    local arr=readPointer(q+invf.Offset) or 0; if arr==0 then return end
    local n=readInteger(arr+8) or 0
    for i=0,n-1 do
      local it=readPointer(arr+0x10+i*8) or 0
      if it~=0 then
        local typ=readInteger(it+ft.Offset) or 0
        local pref=readByte(it+fp.Offset) or 0
        local stack=readInteger(it+fs.Offset) or 0
        local ammo=readInteger(it+fa.Offset) or 0
        if typ~=0 and ammo&gt;0 and stack&gt;0 then
          local st=x64ct.ammoState[i]
          if not st or st.type~=typ or st.prefix~=pref then
            st={type=typ,prefix=pref,baseline=stack,original=stack,bumped=false}
            if stack==1 then
              st.baseline=2; st.bumped=true; writeInteger(it+fs.Offset,2); stack=2
            end
            x64ct.ammoState[i]=st
          else
            if stack&lt;st.baseline then writeInteger(it+fs.Offset,st.baseline)
            elseif stack&gt;st.baseline then st.baseline=stack end
          end
        else
          x64ct.ammoState[i]=nil
        end
      end
    end
  end)
end

function x64ctDisableInfiniteAmmo()
  x64ctStopTimer('infinite-ammo')
  local p=x64ctPlayer()
  if p~=0 and x64ct.ammoState then
    local invf=x64ctField('Terraria.Player','inventory',true)
    local ft=x64ctField('Terraria.Item','type',true)
    local fp=x64ctField('Terraria.Item','prefix',true)
    local fs=x64ctField('Terraria.Item','stack',true)
    if invf and ft and fp and fs then
      local arr=readPointer(p+invf.Offset) or 0
      if arr~=0 then
        for i,st in pairs(x64ct.ammoState) do
          local it=readPointer(arr+0x10+i*8) or 0
          if it~=0 and st.bumped and (readInteger(it+ft.Offset) or 0)==st.type and (readByte(it+fp.Offset) or 0)==st.prefix then
            local cur=readInteger(it+fs.Offset) or 0
            if cur==st.baseline then writeInteger(it+fs.Offset,st.original) end
          end
        end
      end
    end
  end
  x64ct.ammoState=nil
end

-- --------------------------------------------------------------------------
-- CommonDrop object editing. Uses GC handles so objects remain valid if CoreCLR moves them.
-- --------------------------------------------------------------------------
local x64ctCommonDropTypes={
  'Terraria.GameContent.ItemDropRules.CommonDrop',
  'Terraria.GameContent.ItemDropRules.CommonDropNotScalingWithLuck',
  'Terraria.GameContent.ItemDropRules.CommonDropWithRerolls',
  'Terraria.GameContent.ItemDropRules.DropLocalPerClientAndResetsNPCMoneyTo0',
  'Terraria.GameContent.ItemDropRules.DropPerPlayerOnThePlayer',
  'Terraria.GameContent.ItemDropRules.ItemDropWithConditionRule'
}

function x64ctEnsureDropCapture()
  if x64ct.drop.objects then return end
  x64ctEnsureDotNet()
  local base=x64ctType('Terraria.GameContent.ItemDropRules.CommonDrop',false)
  local fd=x64ctField(base.name,'chanceDenominator',false)
  local fmin=x64ctField(base.name,'amountDroppedMinimum',false)
  local fmax=x64ctField(base.name,'amountDroppedMaximum',false)
  x64ct.drop.fields={den=fd,min=fmin,max=fmax}
  x64ct.drop.objects={}
  local seen={}
  for _,name in ipairs(x64ctCommonDropTypes) do
    local t=x64ctType(name,true)
    if t then
      local objs=x64ct.dc.enumAllObjectsOfType(t.moduleHandle,t.token) or {}
      for i=1,#objs do
        local a=objs[i]
        if a and a~=0 and not seen[a] then
          seen[a]=true
          local h=dotnet_wrapobject(a)
          if h and h~=0 then
            local p=readPointer(h) or 0
            if p~=0 then
              x64ct.drop.objects[#x64ct.drop.objects+1]={
                handle=h,
                den=readInteger(p+fd.Offset) or 1,
                min=readInteger(p+fmin.Offset) or 1,
                max=readInteger(p+fmax.Offset) or 1
              }
            else
              pcall(dotnet_unwrapobject,h)
            end
          end
        end
      end
    end
  end
  if #x64ct.drop.objects==0 then error('No live CommonDrop rule objects were found. Enter a world, then try again.') end
end

function x64ctApplyDropState()
  if not x64ct.drop.objects then return end
  local f=x64ct.drop.fields
  local mult=1
  if x64ct.drop.enabledMult and x64ct.drop.multStorage then
    mult=readInteger(x64ct.drop.multStorage) or 1
    if mult&lt;1 then mult=1 end
    if mult&gt;1000 then mult=1000 end
  end
  for _,o in ipairs(x64ct.drop.objects) do
    local p=readPointer(o.handle) or 0
    if p~=0 then
      writeInteger(p+f.den.Offset,x64ct.drop.enabled100 and 1 or o.den)
      writeInteger(p+f.min.Offset,math.max(1,o.min*mult))
      writeInteger(p+f.max.Offset,math.max(1,o.max*mult))
    end
  end
end

function x64ctReleaseDropCapture()
  if not x64ct.drop.objects then return end
  local f=x64ct.drop.fields
  for _,o in ipairs(x64ct.drop.objects) do
    local p=readPointer(o.handle) or 0
    if p~=0 then
      writeInteger(p+f.den.Offset,o.den)
      writeInteger(p+f.min.Offset,o.min)
      writeInteger(p+f.max.Offset,o.max)
    end
    pcall(dotnet_unwrapobject,o.handle)
  end
  x64ct.drop.objects=nil
  x64ct.drop.fields=nil
end

function x64ctEnableDrop100()
  x64ctEnsureDropCapture()
  x64ct.drop.enabled100=true
  x64ctApplyDropState()
end
function x64ctDisableDrop100(silent)
  if not x64ct.drop then return end
  x64ct.drop.enabled100=false
  if x64ct.drop.objects then x64ctApplyDropState() end
  if not x64ct.drop.enabledMult then x64ctReleaseDropCapture() end
end

function x64ctEnableDropMultiplier()
  x64ctEnsureDropCapture()
  pcall(unregisterSymbol,'dropMultiplier')
  x64ct.drop.multStorage=allocateMemory(4)
  if not x64ct.drop.multStorage then error('Could not allocate dropMultiplier.') end
  writeInteger(x64ct.drop.multStorage,2)
  registerSymbol('dropMultiplier',x64ct.drop.multStorage,true)
  x64ct.drop.enabledMult=true
  x64ctStartTimer('drop-multiplier',100,x64ctApplyDropState)
end
function x64ctDisableDropMultiplier(silent)
  x64ctStopTimer('drop-multiplier')
  if not x64ct.drop then return end
  x64ct.drop.enabledMult=false
  if x64ct.drop.objects then x64ctApplyDropState() end
  pcall(unregisterSymbol,'dropMultiplier')
  if x64ct.drop.multStorage then pcall(deAlloc,x64ct.drop.multStorage) end
  x64ct.drop.multStorage=nil
  if not x64ct.drop.enabled100 then x64ctReleaseDropCapture() end
end

-- CommonDropWithRerolls: set the managed rerolls field instead of patching an x86 loop branch.
function x64ctEnableRerolls(count)
  local t=x64ctType('Terraria.GameContent.ItemDropRules.CommonDropWithRerolls',false)
  local f=x64ctField(t.name,'rerolls',true)
  if not f then error('CommonDropWithRerolls.rerolls field was not found in this Terraria build.') end
  local objs=x64ct.dc.enumAllObjectsOfType(t.moduleHandle,t.token) or {}
  x64ct.rerolls.objects={}
  for i=1,#objs do
    local h=dotnet_wrapobject(objs[i])
    if h and h~=0 then
      local p=readPointer(h) or 0
      if p~=0 then
        x64ct.rerolls.objects[#x64ct.rerolls.objects+1]={handle=h,original=readInteger(p+f.Offset) or 0}
      else pcall(dotnet_unwrapobject,h) end
    end
  end
  x64ct.rerolls.field=f
  if #x64ct.rerolls.objects==0 then error('No live CommonDropWithRerolls objects were found.') end
  for _,o in ipairs(x64ct.rerolls.objects) do
    local p=readPointer(o.handle) or 0
    if p~=0 then writeInteger(p+f.Offset,count) end
  end
end
function x64ctDisableRerolls(silent)
  if not x64ct.rerolls or not x64ct.rerolls.objects then return end
  local f=x64ct.rerolls.field
  for _,o in ipairs(x64ct.rerolls.objects) do
    local p=readPointer(o.handle) or 0
    if p~=0 and f then writeInteger(p+f.Offset,o.original) end
    pcall(dotnet_unwrapobject,o.handle)
  end
  x64ct.rerolls.objects=nil
  x64ct.rerolls.field=nil
end

-- --------------------------------------------------------------------------
-- Item Vacuum. Override managed GetItemGrabRange entry with: mov eax,imm32 ; ret
-- The original 6 bytes are restored exactly on disable.
-- --------------------------------------------------------------------------
function x64ctVacuumWriteReturn()
  if not x64ct.vacuumAddress or not x64ct.vacuumStorage then return end
  local blocks=readFloat(x64ct.vacuumStorage) or 2.625
  if blocks&lt;0 then blocks=0 end
  if blocks&gt;10000 then blocks=10000 end
  local px=math.floor(blocks*16+0.5)
  local b1=px%256
  local b2=math.floor(px/256)%256
  local b3=math.floor(px/65536)%256
  local b4=math.floor(px/16777216)%256
  writeBytes(x64ct.vacuumAddress,0xB8,b1,b2,b3,b4,0xC3)
  if type(flushInstructionCache)=='function' then pcall(flushInstructionCache,x64ct.vacuumAddress,6) end
end

function x64ctEnableItemVacuum()
  if x64ct.vacuumAddress then return end
  local a=x64ctMethodEntry('Terraria.Player','GetItemGrabRange',1)
  local original=readBytes(a,6,true)
  if not original or #original~=6 then error('Could not read GetItemGrabRange entry bytes.') end
  x64ct.vacuumAddress=a
  x64ct.vacuumOriginal=original
  pcall(unregisterSymbol,'grabBlocks')
  x64ct.vacuumStorage=allocateMemory(4)
  if not x64ct.vacuumStorage then error('Could not allocate grabBlocks.') end
  writeFloat(x64ct.vacuumStorage,2.625)
  registerSymbol('grabBlocks',x64ct.vacuumStorage,true)
  x64ctStartTimer('item-vacuum',50,x64ctVacuumWriteReturn)
end

function x64ctDisableItemVacuum(silent)
  x64ctStopTimer('item-vacuum')
  if x64ct.vacuumAddress and x64ct.vacuumOriginal then
    pcall(function() writeBytes(x64ct.vacuumAddress,x64ct.vacuumOriginal) end)
    if type(flushInstructionCache)=='function' then pcall(flushInstructionCache,x64ct.vacuumAddress,6) end
  end
  pcall(unregisterSymbol,'grabBlocks')
  if x64ct.vacuumStorage then pcall(deAlloc,x64ct.vacuumStorage) end
  x64ct.vacuumStorage=nil
  x64ct.vacuumAddress=nil
  x64ct.vacuumOriginal=nil
end

-- --------------------------------------------------------------------------
-- Town NPC immortality. Stronger than the old death-only rescue: while enabled,
-- town NPCs are marked dontTakeDamage. Original flags are restored per live object.
-- --------------------------------------------------------------------------
function x64ctEnableNpcImmortal()
  local t=x64ctType('Terraria.NPC',false)
  local fa=x64ctField('Terraria.NPC','active',false)
  local ft=x64ctField('Terraria.NPC','townNPC',false)
  local fd=x64ctField('Terraria.NPC','dontTakeDamage',false)
  local objs=x64ct.dc.enumAllObjectsOfType(t.moduleHandle,t.token) or {}
  if #objs==0 then error('No live Terraria.NPC objects were found.') end
  x64ct.npcImmortalObjects={}
  for i=1,#objs do
    local h=dotnet_wrapobject(objs[i])
    if h and h~=0 then x64ct.npcImmortalObjects[#x64ct.npcImmortalObjects+1]={handle=h,original=nil} end
  end
  x64ctStartTimer('npc-immortal',100,function()
    for _,o in ipairs(x64ct.npcImmortalObjects) do
      local npc=readPointer(o.handle) or 0
      if npc~=0 and (readByte(npc+fa.Offset) or 0)~=0 and (readByte(npc+ft.Offset) or 0)~=0 then
        if o.original==nil then o.original=readByte(npc+fd.Offset) or 0 end
        writeByte(npc+fd.Offset,1)
      end
    end
  end)
end

function x64ctDisableNpcImmortal()
  x64ctStopTimer('npc-immortal')
  if x64ct.npcImmortalObjects then
    local fd=x64ctField('Terraria.NPC','dontTakeDamage',true)
    for _,o in ipairs(x64ct.npcImmortalObjects) do
      local npc=readPointer(o.handle) or 0
      if npc~=0 and fd and o.original~=nil then writeByte(npc+fd.Offset,o.original) end
      pcall(dotnet_unwrapobject,o.handle)
    end
  end
  x64ct.npcImmortalObjects=nil
end

-- ============================================================================
-- UI: Compact Mode + Creator Links + x64 gloader auto-attach
-- ============================================================================
function cycleFullCompact(sender, force)
  local form = getMainForm()
  local state = not (compactmenuitem.Caption == 'Compact View Mode')
  if force ~= nil then state = not force end
  compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'
  form.Splitter1.Visible = state
  form.Panel4.Visible = state
  form.Panel5.Visible = state
end

function addCustomInterface()
  if customInterfaceAdded then return end
  local parent = getMainForm().Menu.Items

  local ucItem = createMenuItem(parent)
  parent.add(ucItem)
  ucItem.Caption = 'UnknownCheats'
  ucItem.OnClick = function() shellExecute('https://www.unknowncheats.me/forum/members/2529642.html') end

  local flItem = createMenuItem(parent)
  parent.add(flItem)
  flItem.Caption = 'FearLess'
  flItem.OnClick = function() shellExecute('https://fearlessrevolution.com/memberlist.php?mode=viewprofile&amp;u=252368') end

  compactmenuitem = createMenuItem(parent)
  parent.add(compactmenuitem)
  compactmenuitem.Caption = 'Compact View Mode'
  compactmenuitem.OnClick = cycleFullCompact

  customInterfaceAdded = true
end

function autoAttach()
  if getOpenedProcessID() == 0 then
    local pid=getProcessIDFromProcessName('gloader.exe')
    if pid~=0 then
      openProcess('gloader.exe')
      attachTimer.Enabled=false
    end
  else
    attachTimer.Enabled=false
  end
end

addCustomInterface()
cycleFullCompact(nil,true)

if attachTimer then x64ctSafeDestroy(attachTimer) end
attachTimer=createTimer(getMainForm())
attachTimer.Interval=1000
attachTimer.OnTimer=autoAttach
attachTimer.Enabled=true
</LuaScript>
  <Comments>
Experimental x64 CoreCLR port for gloader/TerrariaRelease.dll. Original x86 table left untouched. Runtime field offsets are resolved through Cheat Engine .NET metadata. Entries prefixed with x64 TODO are deliberately disabled.
</Comments>
</CheatTable>